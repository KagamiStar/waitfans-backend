# Copy to deploy/.env.server, replace every "change-me" value, and never commit it.
COMPOSE_PROJECT_NAME=waitfans
WAITFANS_IMAGE_TAG=latest
WAITFANS_BIND_ADDRESS=127.0.0.1
WAITFANS_SERVER_PORT=7070
WAITFANS_IM_PORT=7071

WAITFANS_DB_USERNAME=waitfans_app
WAITFANS_DB_PASSWORD=change-me-to-a-long-random-database-password
WAITFANS_DB_ROOT_PASSWORD=change-me-to-a-different-long-random-root-password

WAITFANS_REDIS_PASSWORD=change-me-to-a-long-random-redis-password
WAITFANS_ES_HEAP=1g
WAITFANS_JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0

WAITFANS_OSS_BUCKET=change-me
WAITFANS_OSS_BUCKET_URL=https://change-me.example.com/
WAITFANS_OSS_ENDPOINT=https://oss-cn-your-region.aliyuncs.com
WAITFANS_OSS_KEY_ID=change-me
WAITFANS_OSS_KEY_SECRET=change-me
